# Local development service. Create the mammoth user and data directory before use.
[Unit]
Description=Mammoth local storage
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mammoth
Group=mammoth
ExecStart=/usr/local/bin/mammoth --local-root /var/lib/mammoth/local serve --role all --ui-listen 127.0.0.1:8080 --s3-listen 127.0.0.1:9000
Restart=on-failure
RestartSec=5s
KillSignal=SIGINT
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mammoth

[Install]
WantedBy=multi-user.target
