---
// Use the custom landing hero on Mammoth's homepage. Other splash pages retain
// Starlight's hero. Component and frontmatter URLs bypass the Markdown plugin,
// so both paths use withBase() to work at / and at /Mammoth/.
import Default from '@astrojs/starlight/components/Hero.astro';
import LandingHero from './LandingHero.astro';
import { withBase } from '../lib/links';

const { entry } = Astro.locals.starlightRoute;
const { hero } = entry.data;

const rebased = hero && {
    ...hero,
    actions: hero.actions?.map((action) => ({
        ...action,
        link: withBase(action.link),
    })),
    image:
        hero.image && 'html' in hero.image
            ? {
                  ...hero.image,
                  html: hero.image.html.replace(
                      /src="(\/[^"]*)"/g,
                      (_, url) => `src="${withBase(url)}"`,
                  ),
              }
            : hero.image,
};

// Starlight 0.42 reads route data from locals rather than component props.
Astro.locals.starlightRoute.entry = {
    ...entry,
    data: { ...entry.data, hero: rebased },
};
---

{
    entry.data.template === 'splash' && entry.data.title === 'Mammoth' ? (
        <LandingHero />
    ) : (
        <Default />
    )
}
