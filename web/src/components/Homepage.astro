---
import { withBase } from '../lib/links';
import BenchmarkEvidence from './BenchmarkEvidence.astro';
const repository = 'https://github.com/ProjectOrcha/Mammoth';
const paths = [
    {
        number: '01',
        tag: 'Start here',
        title: 'Learn the essentials',
        text: 'Go from “what is a block?” to your first small Rust change, with examples and a map of the code.',
        action: 'Open the beginner guides',
        href: withBase('/contributing/'),
    },
    {
        number: '02',
        tag: 'Your team of four',
        title: 'Build together',
        text: 'Divide the work, keep branches in sync, and review each other’s changes with a shared workflow.',
        action: 'See the team playbook',
        href: `${repository}/blob/main/docs/guide/TEAM-PLAN.md`,
    },
    {
        number: '03',
        tag: 'Everyone is welcome',
        title: 'Make a contribution',
        text: 'Find a task, fork the repository, and open a pull request. You can start with documentation or UI.',
        action: 'Read the contributor steps',
        href: `${repository}/blob/main/docs/guide/EXTERNAL-CONTRIBUTORS.md`,
    },
];
---

<div class="mm-homepage">
    <aside class="mm-development not-content" aria-label="Project availability">
        <span class="mm-development-badge">Local preview</span>
        <p>
            <strong>Explore what works today.</strong> The local storage service, live dashboard, S3 subset,
            benchmarks and configuration are available on AI_coded. Authentication,
            distributed services and high availability remain unfinished.
        </p>
        <a href={withBase('/ops/local-service/')}
            >Operating guide <span aria-hidden="true">↗</span></a
        >
    </aside>

    <section class="mm-home-section not-content" aria-labelledby="measured-performance">
        <div class="mm-section-heading">
            <div><p class="mm-label">Evidence, in the open</p><h2 id="measured-performance">Measured on Mac. Compared in the open.</h2></div>
            <a href={withBase('/ops/benchmarks/')}>Benchmark method →</a>
        </div>
        <p>Our local benchmark suite compares storage I/O, cached reads, metadata and parallel text jobs, with repeatable settings, exact validation and downloadable results.</p>
        <BenchmarkEvidence compact />
    </section>

    <section
        class="mm-home-section not-content"
        aria-labelledby="find-your-way"
    >
        <div class="mm-section-heading">
            <div>
                <p class="mm-label">A place to start</p><h2 id="find-your-way">
                    Find your way in.
                </h2>
            </div><p>
                You don’t need to understand the whole system to make your first
                contribution.
            </p>
        </div>
        <div class="mm-paths">
            {
                paths.map((path) => (
                    <a class="mm-path" href={path.href}>
                        <>
                            <div class="mm-path-top">
                                <>
                                    <span class="mm-path-number">
                                        {path.number}
                                    </span>
                                    <span class="mm-label">{path.tag}</span>
                                </>
                            </div>
                            <h3>{path.title}</h3>
                            <p>{path.text}</p>
                            <span class="mm-path-action">
                                {path.action} <span aria-hidden="true">↗</span>
                            </span>
                        </>
                    </a>
                ))
            }
        </div>
    </section>

    <section
        class="mm-home-section mm-try-section"
        id="try-it"
        aria-labelledby="try-it-title"
    >
        <div class="mm-try-copy not-content">
            <p class="mm-label">From reading to exploring</p><h2
                id="try-it-title"
            >
                Make it real.<br /><span>Run it locally.</span>
            </h2><p>
                The dashboard is the quickest way to explore Mammoth. Browse
                files, upload data, inspect replicated blocks, run benchmarks,
                and prepare your storage configuration.
            </p><ul>
                <li>No cluster setup for the demo</li><li>
                    Example data included
                </li><li>Dark and light themes</li>
            </ul><a href={withBase('/intro/install/')}
                >Full setup instructions <span aria-hidden="true">→</span></a>
        </div>
        <div class="mm-quickstart"><slot /></div>
    </section>

    <section class="mm-home-section not-content" aria-labelledby="how-it-fits">
        <div class="mm-section-heading">
            <div>
                <p class="mm-label">The idea, in three parts</p><h2
                    id="how-it-fits"
                >
                    A system you can follow.
                </h2>
            </div><a href={withBase('/concepts/architecture/')}
                >Explore the architecture <span aria-hidden="true">→</span></a>
        </div>
        <p class="mm-design-note">
            The planned architecture separates requests, metadata, and file
            contents. These backend roles are still under development.
        </p>
        <ol class="mm-architecture">
            <li>
                <span class="mm-role-icon" aria-hidden="true">↗</span><span
                    class="mm-label">01 / Gateway</span
                ><h3>The front door</h3><p>
                    Accepts requests from the CLI, dashboard, and the
                    development S3 API.
                </p><span class="mm-role-detail">“Read this file.”</span>
            </li>
            <li>
                <span class="mm-role-icon" aria-hidden="true">◇</span><span
                    class="mm-label">02 / Masters</span
                ><h3>The index</h3><p>
                    Tracks names, permissions, and where the pieces of each file
                    belong.
                </p><span class="mm-role-detail"
                    >“Here’s where to find it.”</span>
            </li>
            <li>
                <span class="mm-role-icon" aria-hidden="true">▦</span><span
                    class="mm-label">03 / Workers</span
                ><h3>The shelves</h3><p>
                    Store file fragments and help rebuild them when another
                    worker is unavailable.
                </p><span class="mm-role-detail">“Here are your bytes.”</span>
            </li>
        </ol>
        <div class="mm-deeper">
            <p>Curious about the performance design?</p><a
                href={withBase('/concepts/fast-paths/')}
                >Read about the four fast paths <span aria-hidden="true">→</span
                ></a>
        </div>
    </section>

    <section class="mm-invitation not-content" aria-labelledby="build-with-us">
        <div>
            <p class="mm-label">Built in the open</p><h2 id="build-with-us">
                Small contributions.<br />A shared Mammoth.
            </h2><p>
                A clearer explanation, a better screen, your first Rust
                function.<br />There’s room for all of it.
            </p>
        </div><a class="mm-button mm-button-primary" href={repository}
            >Explore the source <span aria-hidden="true">↗</span></a>
    </section>
    <footer class="mm-home-footer not-content">
        <span>Mammoth · Distributed storage, in Rust.</span><a
            href={withBase('/intro/hadoop-primer/')}
            >New to distributed systems? Start here <span aria-hidden="true"
                >→</span
            ></a>
    </footer>
</div>
